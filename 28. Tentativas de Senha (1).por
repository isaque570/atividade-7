programa {
  funcao inicio() {
  cadeia senha
  cadeia porta = "6304"
  faca { 
    escreva("Digite a senha:")
    leia(senha)

    se(senha != porta){ 
      escreva("Acesso negado! Tente novamente: ")

    }
  }
  enquanto (senha != porta)
  escreva("Acesso concedido. Seja Bem-vindo")
  
 
 

 
 
 
    
  }
}
