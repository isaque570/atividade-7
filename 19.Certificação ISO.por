programa {
  funcao inicio() {
    inteiro teste1, teste2, teste3, media
    escreva("Digite qual foi o nível dos três testes: ")
    leia(teste1)
    leia(teste2)
    leia(teste3)

    se (teste1 + teste2 + teste3 / 3 >= 7)
    escreva("Você é um operador ouro!")
    senao
    escreva("Precisa de reciclagem!")
  }
}
