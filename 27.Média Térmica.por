programa {
  funcao inicio() {
    inteiro temp,temp2,temp3,temp4,temp5,temp6,temp7,temp8,temp9,temp10,media
    escreva("Digite a temperatura dos dez pontos da fábrica: ")
    leia(temp)
    leia(temp2)
    leia(temp3)
    leia(temp4)
    leia(temp5)
    leia(temp6)
    leia(temp7)
    leia(temp8)
    leia(temp9)
    leia(temp10)
    media = (temp + temp2 + temp3 + temp4 + temp5 + temp6 + temp7 + temp8 + temp9 + temp10) / 10
    escreva("A média térmica do ambiente é: ", media)
  }
}
//27.Média Térmica: Leia a temperatura de 10 pontos diferentes da fábrica e, ao
//final, exiba a média térmica do ambiente.