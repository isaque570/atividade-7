programa {
  funcao inicio() {
    inteiro pa, pb
    escreva("Digite a pontuação do setor A: ")
    leia(pa)
    escreva("Digite a pontuação do setor B: ")
    leia(pb)
    se(pa > pb)
    escreva("Setor A produziu mais peças hoje!")
    senao
    escreva("Setor B produziu mais peças hoje!")
  }
}
